# ==========================================================================
# .env.production.example — salin jadi .env.production DI VPS, jangan di git.
# Root .gitignore sudah menutup .env.* kecuali berkas contoh ini.
#
# Deploy:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# ==========================================================================

# ---- Database: Supabase, port 5432 session mode --------------------------
# BUKAN 6543. Pooler transaction mode tidak mendukung prepared statement
# postgres-js, dan drizzle.config.ts akan menolaknya (Putaran 15 A4).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- Secrets -------------------------------------------------------------
# Bangkitkan dengan: openssl rand -base64 48
#
# ENCRYPTION_KEY WAJIB dicadangkan di password manager tim. Ia mengenkripsi
# NIK mustahiq dan NIK hasil OCR dokumen Nadzir. Kalau hilang, seluruh NIK
# tersimpan tidak dapat dibaca kembali — tidak ada jalur pemulihan.
# Ia juga WAJIB berbeda dari JWT_SECRET (temuan AMW-08).
JWT_SECRET=
ENCRYPTION_KEY=
INTERNAL_SECRET=

# ---- Alamat publik ---------------------------------------------------------
# WAJIB di produksi: tujuan tombol "Kembali ke Merchant" di Mayar dan QR
# sertifikat. Tanpa ini aplikasi memakai header x-forwarded-host dari Traefik,
# dan TIDAK PERNAH jatuh ke localhost.
PUBLIC_APP_URL=https://amwal.id

# ---- Payment: Mayar (QRIS) ------------------------------------------------
# QRIS, Virtual Account, dan E-Wallet (aktifkan channelnya di dasbor Mayar).
# Webhook: https://amwal.id/api/webhooks/mayar. API key PRODUKSI wajib dipakai
# dengan host produksi; key sandbox hanya valid di api.mayar.io.
# Cek koneksi: bun --env-file=.env.production run scripts/test-mayar.ts --no-create
# MAYAR_WEBHOOK_SECRET = nilai header `x-callback-token` dari Mayar.
PAYMENT_PROVIDER=MAYAR_PRODUCTION
MAYAR_API_KEY=
MAYAR_WEBHOOK_SECRET=
MAYAR_BASE_URL=https://api.mayar.id/hl/v1

# ---- Email (OTP reset kata sandi) -----------------------------------------
# Tanpa SMTP_HOST aplikasi tetap jalan, tetapi email OTP tidak terkirim.
# Gmail: aktifkan verifikasi 2 langkah, buat "App Password" 16 karakter di
# https://myaccount.google.com/apppasswords, lalu pakai sebagai SMTP_PASSWORD
# (bukan kata sandi akun Google). Port 587 = STARTTLS, 465 = TLS langsung.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Amwal <noreply@amwal.id>"

# --- amwal-rag (jawaban fiqih dengan sumber rujukan) ---
# Tanpa RAG_API_KEY, Tanya AI memakai jalur DeepSeek/jawaban bawaan.
RAG_SERVICE_URL=http://amwal-rag-mfbjtj:8000
RAG_API_KEY=
# RAG_TIMEOUT_MS=70000
