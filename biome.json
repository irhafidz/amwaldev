{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.source",
      "!**/tsconfig.json",
      "!**/tsconfig.*.json"
    ]
  },
  "extends": ["ultracite"],
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noAwaitInLoop": "off",
        "noShadow": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "nursery": {
            "noUnknownAtRule": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/wa-bot/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "off"
          },
          "nursery": {
            "noAwaitInLoop": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["**/routes/**/*"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/admin/**",
        "apps/web/src/components/ziswaf/**",
        "apps/web/src/types/**"
      ],
      "linter": {
        "enabled": false
      }
    }
  ]
}
