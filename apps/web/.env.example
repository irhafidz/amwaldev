# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/my_better_t_app"

# Auth
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="your-32-character-secret-key-here-123456789"
ENCRYPTION_KEY="your-32-character-secret-key-here-123456789"
INTERNAL_SECRET="change-me-internal-secret"
BAILEYS_SERVICE_URL="http://localhost:3005"

# Alamat publik (tujuan kembali dari Mayar, QR sertifikat). Kosongkan di dev
# (jatuh ke http://localhost:3000); WAJIB https://amwal.id di produksi.
PUBLIC_APP_URL="http://localhost:3000"

# Payment Adapter
# Options: MAYAR_SANDBOX | MAYAR_PRODUCTION | MOCK_SANDBOX | MIDTRANS_SANDBOX
# Metode: QRIS, Virtual Account (BSI/Mandiri/BNI/BRI/Permata/CIMB/BJB), E-Wallet
# (GoPay/DANA/ShopeePay/LinkAja) — harus aktif di dasbor Mayar. MOCK_SANDBOX untuk dev tanpa jaringan.
PAYMENT_PROVIDER="MAYAR_SANDBOX"
VITE_PAYMENT_PROVIDER="MAYAR_SANDBOX"

# Mayar (wajib saat PAYMENT_PROVIDER adalah MAYAR_*)
# Sandbox: https://api.mayar.io/hl/v1 — Produksi: https://api.mayar.id/hl/v1
# API key sandbox HANYA valid di host sandbox, key produksi hanya di host produksi
# (salah pasangan = 401 Unauthorized). Cek: bun --env-file=<env> run scripts/test-mayar.ts
MAYAR_API_KEY=""
# Persis nilai header `x-callback-token` yang Mayar kirim pada setiap webhook.
MAYAR_WEBHOOK_SECRET=""
MAYAR_BASE_URL="https://api.mayar.io/hl/v1"
# Daftarkan di dasbor Mayar: <PUBLIC_APP_URL>/api/webhooks/mayar
# Bila belum bisa mendaftarkan webhook, halaman status pesanan tetap menanyakan
# status ke Mayar secara langsung dan menyelesaikan pembayaran.

# Midtrans / Mock Server Key (Optional; required only when PAYMENT_PROVIDER is MOCK_SANDBOX or MIDTRANS_*)
PAYMENT_SERVER_KEY="mock-server-key-not-a-real-secret"


# Sprint 11: Cron jobs (POST /api/cron/payments-reconcile & POST /api/cron/streak)
CRON_SECRET="change-me-cron-secret"

# OAuth Providers (optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional
VITE_APP_TITLE="My Better T App"

# Email (OTP reset kata sandi). Opsional di dev: tanpa SMTP_HOST kode OTP
# dicetak ke log server (hanya di luar NODE_ENV=production).
# Gmail: gunakan App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Amwal <noreply@example.com>"

# --- amwal-rag (jawaban fiqih dengan sumber rujukan) ---
# Tanpa RAG_API_KEY, Tanya AI memakai jalur DeepSeek/jawaban bawaan.
RAG_SERVICE_URL=http://amwal-rag-mfbjtj:8000
RAG_API_KEY=
# RAG_TIMEOUT_MS=70000
