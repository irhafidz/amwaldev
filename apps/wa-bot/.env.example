# wa-bot (Baileys) — listens on an internal port only; never publish it.
PORT=3005

# MUST be byte-identical to INTERNAL_SECRET in apps/web/.env (and the same
# variable in docker-compose, which feeds both services). apps/web sends it as
# `X-Internal-Secret`; any mismatch makes wa-bot answer 401, which the admin
# WhatsApp card shows as "Ditolak wa-bot (http-401)".
# Accepts WA_BOT_SECRET as an alias. Required when NODE_ENV=production.
INTERNAL_SECRET=change-me-internal-secret
